<% content_for :page_title do %>
Recuperar Contraseña - Cavallaro S.A.C.e.I.
<% end %>


<div class="elements-content-wrapper">
  <div class="block-login-center">
    <h3 class="text-red login-title-top">Recuperar Contraseña</h3>



    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="form-group">
      <%= f.label :email, 'E-mail', class:"text-grey label-input-login" %>
      <%= f.email_field :email, autocomplete: "email", class: "form-control input-form-normal", required: true  %>
    </div>

    <div class="actions">
      <%= f.submit "RECUPERAR", class:"bg-red btn-submit-login brd0 text-white"  %>
    </div>
    <% end %>

    <%= render "devise/shared/links" %>