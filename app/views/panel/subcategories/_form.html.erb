<%= form_with(model: subcategory, local: true, :url => (subcategory.new_record? ? panel_subcategories_path : panel_subcategory_path(subcategory)), class: "form-horizontal") do |form| %>
<% if subcategory.errors.any? %>
<div id="error_explanation">
  <h2><%= pluralize(subcategory.errors.count, "error") %> prohibited this subsubcategory from being saved:</h2>

  <ul>
    <% subcategory.errors.full_messages.each do |message| %>
    <li><%= message %></li>
    <% end %>
  </ul>
</div>
<% end %>

<div class="col-12">
  <ul class="nav nav-tabs" role="tablist">
    <li class="nav-item"><a class="nav-link active" data-toggle="tab" href="#es" role="tab" aria-controls="es">
        <i class="c-icon cif-py"></i></a></li>
    <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#en" role="tab" aria-controls="en">
        <i class="c-icon cif-us"></i></a></li>
    <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#br" role="tab" aria-controls="br">
        <i class="c-icon cif-br"></i></a></li>
  </ul>
  <br />
  <div class="tab-content">
    <div class="tab-pane active" id="es" role="tabpanel">
      <div class="form-group row">
        <%= form.label "Nombre", class: "col-2 col-form-label" %>
        <div class="col-10">
          <%= form.text_field :name_es, class:"form-control" %>
        </div>
      </div>
    </div>
    <div class="tab-pane" id="en" role="tabpanel">
      <div class="form-group row">
        <%= form.label "Nombre", class: "col-2 col-form-label" %>
        <div class="col-10">
          <%= form.text_field :name_en, class:"form-control" %>
        </div>
      </div>
    </div>
    <div class="tab-pane" id="br" role="tabpanel">
      <div class="form-group row">
        <%= form.label "Nombre", class: "col-2 col-form-label" %>
        <div class="col-10">
          <%= form.text_field :name_br, class:"form-control" %>
        </div>
      </div>
    </div>

    <hr />
    <div class="form-group row">
      <%= form.label "Categoría", class: "col-2 col-form-label" %>
      <div class="col-10">
        <%= form.select(:category_id, Category.where(active: :true).collect {|c| [c.name, c.id]}, {}, {:class => 'custom-select'}) %>

      </div>
    </div>
    <div class="form-group row">
      <%= form.label "Activo", class: "col-2 col-form-label" %>
      <div class="col-10">
        <label class="c-switch c-switch-sm c-switch-pill c-switch-success">
          <%= form.check_box :active, class:"c-switch-input" %>
          <span class="c-switch-slider"></span>
        </label>
      </div>
    </div>

    <div class="form-group row">
      <div class="col-12">
        <%= form.submit (subcategory.new_record? ? "Crear" : "Actualizar" ), class: "btn btn-success m-5" %>
        <%= link_to 'Cancelar', panel_subcategories_path, data: { turbolinks: false }, class: "btn btn-secondary m-5" %>
      </div>
    </div>

  </div>
</div>
<% end %>
