<header id="header" class="header-desktop header-top ">

  <div class="grey-bar-top-menu">
    <div class="grey-bar-buttons-wrapper">

      <div class="">

        <%= form_with url: search_path, method: 'get', id: "formSearch", local: true do %>
        <div class="input-group input-search-wrapper">
          <input type="text" name="q" id="inputSearch" class="input-custom-search form-control"
            placeholder="Buscar Productos..." aria-label="Recipient's username" aria-describedby="basic-addon2"
            required>


          <div class="input-icon-wrapper input-group-append">
            <%= button_tag type: 'submit', class:"input-icon-span input-group-text" do %>
            <i class="fas fa-search"></i>
            <% end %>
          </div>

        </div>
        <% end %>

      </div>
    </div>
  </div>
  <div class="white-bar-top-menu">
    <div class="element-button-white-bar-wrap logo-top-wrapper">
      <a href="<%= root_path %>" title="">
        <%= image_tag "logo-solo.png", class: "logo-top-white-bar", alt: "Logo Cavallaro"  %>
      </a>
    </div>

    <div class="element-button-white-bar-wrap menu-item-white-bar-wrap">
      <a href="<%= category_path('1-cuidado-de-las-prendas') %>" data-turbolinks="false" title=""
        class="link-menu-item-white-bar">
        <%= image_tag "boton-2.png", class: "img-link-menu-white-bar", alt: "Cuidado de Prendas"  %>
        <p class="p-text-menu-item-white-bar">CUIDADO DE LAS PRENDAS</p>
      </a>
    </div>

    <div class="element-button-white-bar-wrap menu-item-white-bar-wrap">
      <a href="<%= category_path('2-higiene-personal') %>" data-turbolinks="false" title=""
        class="link-menu-item-white-bar">
        <%= image_tag "boton-3.png", class: "img-link-menu-white-bar", alt: "Higiene Personal"  %>
        <p class="p-text-menu-item-white-bar">HIGIENE PERSONAL</p>
      </a>
    </div>

    <div class="element-button-white-bar-wrap menu-item-white-bar-wrap">
      <a href="<%= category_path('3-limpieza-y-desinfeccion-del-hogar') %>" data-turbolinks="false" title=""
        class="link-menu-item-white-bar">
        <%= image_tag "boton-1.png", class: "img-link-menu-white-bar", alt: "Limpieza del Hogar"  %>
        <p class="p-text-menu-item-white-bar">LIMPIEZA Y DESINFECCIÓN DEL HOGAR</p>
      </a>
    </div>

    <div class="element-button-white-bar-wrap menu-item-white-bar-wrap">
      <a href="<%= empresa_path %>" title="" class="link-menu-item-white-bar">
        <%= image_tag "boton-4.png", class: "img-link-menu-white-bar", alt: "La Empresa"  %>
        <p class="p-text-menu-item-white-bar">LA EMPRESA</p>
      </a>
    </div>

    <div class="login-register-buttons-wrapper inline-block-vat">

      <% if user_signed_in? %>
      <div class="buttons-wrap align-right">
        <a href="<%= edit_user_registration_path %>" data-turbolinks="false" title=""
          class="button-login-register inline-block-vat mr-0">
          <div class="img-left-button-wrap bg-dark-grey inline-block-vat">

            <i class="fas fa-user"></i>
          </div>
          <span class="text-button-login inline-block-vat">MI PERFIL</span>
        </a>

      </div>
      <div class="buttons-wrap align-right">
        <%= link_to destroy_user_session_path, method: "delete", class:"button-login-register inline-block-vat mr-0" do %>
        <div class="img-left-button-wrap bg-dark-grey inline-block-vat">

          <i class="fas fa-sign-out-alt"></i>
        </div>
        <span class="text-button-login inline-block-vat">SALIR</span>
        <% end %>

      </div>
      <% else %>
      <div class="buttons-wrap align-right">
        <a href="<%= new_user_session_path %>" title="" class="button-login-register inline-block-vat mr-0">
          <div class="img-left-button-wrap bg-dark-grey inline-block-vat">

            <i class="fas fa-user"></i>
          </div>
          <span class="text-button-login inline-block-vat">INGRESAR</span>
        </a>

      </div>
      <% end %>

      <div class="buttons-wrap align-right">
        <a href="<%= shopping_cart_show_path %>" data-turbolinks="false" title=""
          class="button-login-register inline-block-vat mr-0">
          <div class="img-left-button-wrap bg-red inline-block-vat">
            <span
              class="badge badge-pill badge-cart"><%= @shopping_cart.present? ? @shopping_cart.cart_items.count : "0" %></span>

            <i class="fas fa-shopping-cart"></i>
          </div>
          <span class="text-button-login inline-block-vat">CARRITO</span>
        </a>
      </div>

      <div class="align-right">
        <div class="select-country-wrapper">

                <% if false %>
                <% if Setting.all.first.multilanguage %>
                  <form action="" method="get" accept-charset="utf-8">
                    <div class="selec-country-wrap">
                      <span class="flag-icon flag-icon-py inline-block-vat img-flag"></span>
                      <div class="dropdown inline-block-vat">
                        <button class="btn btn-country dropdown-toggle" type="button" id="dropdownMenuButton"
                          data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"><%= @lang.capitalize %></button>
                        <div class="dropdown-menu dropdown-menu-right dropdown-country"
                          aria-labelledby="dropdownMenuButton">
                          <a class="dropdown-item item-country-select" href="<%= set_language_path('es') %>"><span class="c-icon cif-es"></span>
                            Español</a>
                          <a class="dropdown-item item-country-select" href="<%= set_language_path('pt') %>"><span class="c-icon cif-br"></span>
                            Português</a>
                          <a class="dropdown-item item-country-select" href="<%= set_language_path('en') %>"><span class="c-icon cif-us"></span>
                            English</a>
                        </div>
                      </div>
                    </div>
                  </form>
                  <% end %>
                <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="effect6-large" style="background: white;">
    <%= image_tag "costura-grande-sinsombra.png", class: "costura-bottom-white-bar-full", alt: "Imagen separado costura"  %>

  </div>
</header><!-- /header -->

