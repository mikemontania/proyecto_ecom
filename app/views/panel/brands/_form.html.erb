<%= form_with(model: brand, local: true, :url => (brand.new_record? ? panel_brands_path : panel_brand_path(brand)), class: "form-horizontal") do |form| %>
<% if brand.errors.any? %>
<div id="error_explanation">
  <h2><%= pluralize(brand.errors.count, "error") %> prohibited this brand from being saved:</h2>

  <ul>
    <% brand.errors.full_messages.each do |message| %>
    <li><%= message %></li>
    <% end %>
  </ul>
</div>
<% end %>

<div class="col-12">
  <div class="form-group row">
    <%= form.label "Nombre", class: "col-2 col-form-label" %>
    <div class="col-10">
      <%= form.text_field :name, class:"form-control"%>
    </div>
  </div>

  <div class="form-group row">
    <%= form.label "Orden", class: "col-2 col-form-label" %>
    <div class="col-10">
      <%= form.number_field :order, class:"form-control", min: "0" %>
    </div>
  </div>

  <div class="form-group row">
    <%= form.label "Activo", class: "col-2 col-form-label" %>
    <div class="col-10">
      <label class="c-switch c-switch-sm c-switch-pill c-switch-success">
        <%= form.check_box :active, class:"c-switch-input" %>
        <span class="c-switch-slider"></span>
      </label>
    </div>
  </div>

  <div class="form-group row">
    <%= form.label "Logo", class: "col-2 col-form-label" %>

    <% if brand.logo.attached? %>

    <div class="col-3">
      <%= image_tag brand.logo.variant(resize: "100x100!") %>
    </div>
    <div class="col-7">
      <div class="custom-file">
        <%= form.file_field :logo, class:"custom-file" %>
      </div>
    </div>

    <% else %>
    <div class="col-10">
      <div class="custom-file">
        <%= form.file_field :logo, class:"custom-file" %>
      </div>
    </div>

    <% end %>

  </div>


  <div class="form-group row">
    <div class="col-12">
      <%= form.submit (brand.new_record? ? "Crear" : "Actualizar" ), class: "btn btn-success m-5" %>
      <%= link_to 'Cancelar', panel_brands_path, data: { turbolinks: false }, class: "btn btn-secondary m-5" %>
    </div>
  </div>
  <% end %>
