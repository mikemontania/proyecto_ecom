<%= form_with(model: representative, local: true, :url => (representative.new_record? ? panel_representatives_path : panel_representative_path(representative)), class: "form-horizontal") do |form| %>
<% if representative.errors.any? %>
<div id="error_explanation">
  <h2><%= pluralize(representative.errors.count, "error") %> prohibited this representative from being saved:</h2>

  <ul>
    <% representative.errors.full_messages.each do |message| %>
    <li><%= message %></li>
    <% end %>
  </ul>
</div>
<% end %>

<div class="col-12">
  <div class="form-group row">
    <%= form.label "Nombre", class: "col-2 col-form-label" %>
    <div class="col-10">
      <%= form.text_field :name, class:"form-control"%>
    </div>
  </div>

  <div class="form-group row">
    <%= form.label "Dirección", class: "col-2 col-form-label" %>
    <div class="col-10">
      <%= form.text_area :address, class:"form-control" %>
    </div>
  </div>

  <div class="form-group row">
    <%= form.label "Teléfono", class: "col-2 col-form-label" %>
    <div class="col-10">
      <%= form.text_field :phone, class:"form-control" %>
    </div>
  </div>

  <div class="form-group row">
    <%= form.label "Email", class: "col-2 col-form-label" %>
    <div class="col-10">
      <%= form.text_field :email, class:"form-control" %>
    </div>
  </div>

  <div class="form-group row">
    <%= form.label "Sitio Web", class: "col-2 col-form-label" %>
    <div class="col-10">
      <%= form.text_field :website, class:"form-control" %>
    </div>
  </div>


  <div class="form-group row">
    <%= form.label "Latitud", class: "col-2 col-form-label" %>
    <div class="col-10">
      <%= form.text_field :latitude, class:"form-control" %>
    </div>
  </div>

  <div class="form-group row">
    <%= form.label "Longitud", class: "col-2 col-form-label" %>
    <div class="col-10">
      <%= form.text_field :longitude, class:"form-control" %>
    </div>
  </div>

  <div class="form-group row">
    <div class="col-12">
      <%= form.submit (representative.new_record? ? "Crear" : "Actualizar" ), class: "btn btn-success m-5" %>
      <%= link_to 'Cancelar', panel_representatives_path, data: { turbolinks: false }, class: "btn btn-secondary m-5" %>
    </div>
  </div>
  <% end %>
