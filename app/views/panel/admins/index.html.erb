<% @internal_title = "Administradores" %>
<% @page_title = "Administradores" %>
<% @action_button_path = new_panel_admin_registration_path %>

<p class="mb-1">Buscar contenido</p>

<%= form_with url: panel_admins_path, method: 'get', local: true do %>
  <input type="search" name="q" value="<%= @search_text.present? ? @search_text : "" %>"
  class="search-items form-control" autofocus="true" data-table="table-data"
  placeholder="Escribe aqui para buscar...">
<% end %>

<table class="table table-responsive-sm table-striped table-sm table-data">
  <thead>
    <tr>
      <th>Correo</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @admins.each do |admin| %>
    <tr>
      <td><%= admin.email %></td>

      <td><%= link_to edit_panel_admin_registration_path(id: admin) do %>
        <i class="c-icon cil-pencil text-dark" data-toggle="tooltip" title="Editar"></i>
        <% end %>
      </td>
      <td>
        <%= link_to panel_admin_delete_path(id: admin.id), method: :delete, data: { confirm: 'Deseas eliminar este usuario Administrador?' } do %>
        <i class="c-icon cil-trash text-dark" data-toggle="tooltip" title="Eliminar"></i>
        <% end %>
      </td>
      </td>
    </tr>
    <% end %>
  </tbody>
</table>

<%= pagy_bootstrap_nav(@pagy).html_safe %>
