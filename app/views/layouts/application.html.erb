      <% if @time.present? %>
         <script data-turbolinks-eval=false>
           var element = document.getElementById('countdownTimer');

           countdownTimer('<%= j @time %>');
         </script>
      <% end %>

      <script data-turbolinks-eval=false>

          document.addEventListener("turbolinks:load", function () {
          set_slider();
      })

    document.addEventListener('stimulus-reflex:after', event => {
      var toastr_message = document.getElementById('toastr').value;
      if (toastr_message != '') {
        console.log(toastr_message);
        show_toastr(toastr_message);
      }

      set_slider();
    })
      </script>

      <%= yield :scripts %>
      <%= yield :bottom_script %>
