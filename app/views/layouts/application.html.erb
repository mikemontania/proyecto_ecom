          <div class="modal-content">
            <div class="modal-header" style="background: #ce0003;">
              <h5 class="modal-title" id="staticBackdropLabel" style="font-weight: 600; color: white;">Escribinos al WhatsApp</h5>
              <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="padding: 0; opacity: 1; line-height: 1.15;">
                <span style="font-size: 49px; color: white; padding-right: 20px;">&times;</span>
              </button>
            </div>

            <div class="modal-body">
              <div class="content-contact-info-fixed-wrapper">
                <p class="p-text-info-modal-contact-solo text-black">
                  <a href="https://api.whatsapp.com/send?phone=595215889000&text=Hola%2C%20les%20escribo%20desde%20la%20web%20del%20Grupo%20Cavallaro"
                     class="whatsapp-icon-modal">
                     <i class="fab fa-whatsapp" style="margin-left: 6px; font-size: 24px;"></i> Casa Central
                  </a>
                </p>
                <p class="p-text-info-modal-contact-solo text-black">
                  <a href="https://api.whatsapp.com/send?phone=595981627369&text=Hola%2C%20les%20escribo%20desde%20la%20web%20del%20Grupo%20Cavallaro"
