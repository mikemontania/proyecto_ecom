      <% if cookies[:cookie_accepted].nil? %>
        <div class="modal fade" id="cookieModal" data-backdrop="static" data-keyboard="false" tabindex="-1" aria-labelledby="cookieModalLabel" aria-hidden="true">
          <div class="modal-dialog">
            <div class="modal-content">
              <div class="modal-body">
                <div class="content-contact-info-fixed-wrapper">
                  <div class="d-flex justify-content-center">
                    <div class="cookie-card p-3 cookie text-center"><span>Cavallaro S.A.C.e.I usa cookies propias y de terceros para personalizar el contenido, ofrecer mejor perfomance, funciones de redes sociales y análisis del tráfico.<br></span>
                      <div class="mt-4 text-center">
                        <%= link_to "Aceptar cookies", cookie_consent_path(cookies: true), data: { dismiss: "modal" }, remote: true, class: "btn btn-accept-cookie btn-sm" %>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
