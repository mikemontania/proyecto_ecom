<% @internal_title = "Productos" %>
<% @page_title = "Productos" %>
<% @action_button_path = new_panel_product_path %>

<p class="mb-1">Buscar contenido</p>

<%= form_with url: panel_products_path, method: 'get', local: true do %>
  <input type="search" name="q" value="<%= @search_text.present? ? @search_text : "" %>"
  class="search-items form-control" autofocus="true" data-table="table-data"
  placeholder="Escribe aqui para buscar...">
<% end %>

<table class="table table-data">
  <thead>
    <tr>
      <th>Orden</th>
      <th>Nombre</th>
      <th>Categoría</th>
      <th>Subcategoría</th>
      <th>Internos</th>
      <th>Estado</th>
      <th>Destacado</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @products.order(:order).each do |product| %>
    <tr>
      <td><%= product.order.to_i %></td>
      <td><%= product.name.html_safe %></td>
      <td><%= product.category.name.html_safe %></td>
      <td><%= product.subcategory.name.html_safe %></td>
      <td><%= product.internal_products.count.html_safe? %></td>
      <td>
        <%if product.active %>
        <span class="badge badge-pill badge-success">Activo</span>
        <%else%>
        <span class="badge badge-pill badge-secondary">Inactivo</span>
        <%end%>
      </td>
      <td><%if product.featured %>
        <span class="badge badge-warning"><i class="c-icon cil-star"></i></span>
        <%else%>
        <span class="badge badge-pill badge-secondary">-</span>
        <%end%></td>
      <td>
        <%= link_to  panel_product_path(product) do %>
        <i class="c-icon cil-magnifying-glass text-dark" data-placement="top" data-toggle="tooltip" title="Ver"></i>
        <% end %>
      </td>
      <td><%= link_to edit_panel_product_path(product) do %>
        <i class="c-icon cil-pencil text-dark" data-toggle="tooltip" title="Editar"></i>
        <% end %>
      </td>
      <td>
        <%= link_to panel_product_path(product), method: :delete, data: { confirm: 'Deseas eliminar este producto?' } do %>
        <i class="c-icon cil-trash text-dark" data-toggle="tooltip" title="Eliminar"></i>
        <% end %>
      </td>
    </tr>
    <% end %>
  </tbody>
</table>

<%= pagy_bootstrap_nav(@pagy).html_safe %>
