<% @internal_title = "Editar usuario Administrador" %>

<%= form_for(@admin, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |form| %>
  <%= render "panel/admins/shared/error_messages", resource: resource %>

  <div class="col-12">
    <div class="tab-content">
      <div class="tab-pane active" id="es" role="tabpanel">

        <div class="form-group row">
          <%= form.label "Correo electrónico", class: "col-2 col-form-label" %>
          <div class="col-10">
            <%= form.email_field :email, class: "form-control" %>
          </div>
        </div>

        <input type="hidden" name="panel_admin[id]" value="<%= @admin.id %>">

        <h3 class="mt-5 mb-1">Cambiar contraseña</h3>
        <em class="mb-3 d-block">Opcional. Solo si se necesita cambiar la contraseña del usuario administrador.</em>

        <div class="form-group row">
          <div class="col-2">
            <%= form.label "Contraseña", class: "col-form-label" %>
          </div>
          <div class="col-10">
            <%= form.password_field :password, class: "form-control", autocomplete: "new-password" %>
          </div>
        </div>

        <div class="form-group row">
          <%= form.label "Confirmar contraseña", class: "col-2 col-form-label" %>
          <div class="col-10">
            <%= form.password_field :password_confirmation, class: "form-control", autocomplete: "new-password" %>
          </div>
        </div>

        <div class="form-group row">
          <div class="col-12 text-center">
            <%= form.submit "Actualizar", class: "btn btn-success m-5" %>
            <%= link_to 'Cancelar', panel_admins_path, class: "btn btn-secondary m-5" %>
          </div>
        </div>
      </div>
    </div>
  </div>

<% end %>

<div class="col-12 text-center">
</div>
