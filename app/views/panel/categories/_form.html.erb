<%= form_with(model: category, local: true, :url => (category.new_record? ? panel_categories_path : panel_category_path(category)), class: "form-horizontal") do |form| %>
<% if category.errors.any? %>
<div id="error_explanation">
  <h2><%= pluralize(category.errors.count, "error") %> prohibited this category from being saved:</h2>

  <ul>
    <% category.errors.full_messages.each do |message| %>
    <li><%= message %></li>
    <% end %>
  </ul>
</div>
<% end %>

<div class="col-12">
  <ul class="nav nav-tabs" role="tablist">
    <li class="nav-item"><a class="nav-link active" data-toggle="tab" href="#es" role="tab" aria-controls="es">
        <i class="c-icon cif-py"></i></a></li>
    <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#en" role="tab" aria-controls="en">
        <i class="c-icon cif-us"></i></a></li>
    <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#br" role="tab" aria-controls="br">
        <i class="c-icon cif-br"></i></a></li>
  </ul>
  <br />
  <div class="tab-content">
    <div class="tab-pane active" id="es" role="tabpanel">
      <div class="form-group row">
        <%= form.label "Nombre", class: "col-2 col-form-label" %>
        <div class="col-10">
          <%= form.text_field :name_es, class:"form-control" %>
        </div>
      </div>
    </div>
    <div class="tab-pane" id="en" role="tabpanel">
      <div class="form-group row">
        <%= form.label "Nombre", class: "col-2 col-form-label" %>
        <div class="col-10">
          <%= form.text_field :name_en, class:"form-control" %>
        </div>
      </div>
    </div>
    <div class="tab-pane" id="br" role="tabpanel">
      <div class="form-group row">
        <%= form.label "Nombre", class: "col-2 col-form-label" %>
        <div class="col-10">
          <%= form.text_field :name_br, class:"form-control" %>
        </div>
      </div>
    </div>

    <hr />

    <div class="form-group row">
      <%= form.label "Icono", class: "col-2 col-form-label" %>

      <% if category.icon.attached? %>

      <div class="col-3">
        <%= image_tag category.icon %>
      </div>
      <div class="col-7">
        <div class="custom-file">
          <%= form.file_field :icon, class:"custom-file" %>
        </div>
      </div>

      <% else %>
      <div class="col-10">
        <div class="custom-file">
          <%= form.file_field :icon, class:"custom-file" %>
        </div>
      </div>

      <% end %>

    </div>

    <div class="form-group row">
      <%= form.label "Activo", class: "col-2 col-form-label" %>
      <div class="col-10">
        <label class="c-switch c-switch-sm c-switch-pill c-switch-success">
          <%= form.check_box :active, class:"c-switch-input" %>
          <span class="c-switch-slider"></span>
        </label>
      </div>
    </div>

    <div class="form-group row">
      <div class="col-12">
        <%= form.submit (category.new_record? ? "Crear" : "Actualizar" ), class: "btn btn-success m-5" %>
        <%= link_to 'Cancelar', panel_categories_path, data: { turbolinks: false }, class: "btn btn-secondary m-5" %>
      </div>
    </div>

  </div>
</div>
<% end %>
