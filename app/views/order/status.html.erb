<% content_for :page_title do %>
  Operacion finalizada - Cavallaro S.A.C.e.I.
<% end %>

<% content_for :event_google_manager do %>
    <script>
        //console.log("<%= j @order.delivery_payment_method %>");
        var cartItems = JSON.parse("<%= j @allItems.to_json.html_safe %>");

        var gtagData = {};

        if(cartItems.length) {
            "<% if @cupon.present? %>"
                gtagData = {
                    currency: 'PYG',
                    items: cartItems,
                    payment_type: "<%= j @order.delivery_payment_method %>",
                    value: 0
                };
            "<% else %>"
                gtagData = {
                    currency: 'PYG',
                    items: cartItems,
                    payment_type: "<%= j @order.delivery_payment_method %>",
                    value: 0
                };
            "<% end %>"

            gtag('event', 'add_payment_info', gtagData);

        } else {
          console.log("Empty array for gtag.");
        }

    </script>
<% end %>


<div class="col-12 col-md-11 col-xxl-10 m-0 p-0 mt-5 mb-5 mx-auto pasos_box">
  <ul class="list-unstyled multi-steps">
    <li>Dirección de env&iacute;o y facturación</li>
    <li class="is-active">Resumen de compra</li>
    <li>Realizar el pago</li>
    <li>Confirmación de compra</li>
  </ul>
</div>

<div class="resume-box-wrapper col-12 col-md-10 col-lg-7 pl-5 col-xxl-7 mt-5 mb-5 mx-auto">
  <h3 class="text-red title-resume login-title-top">RESUMEN DE LA COMPRA</h3>
  <div class="row no-gutters">
    <% @shopping_cart.cart_items.each do |product| %>

    <div class="col-12 no-gutters m-0 p-0 my-2 ">
      <div class="row no-gutters">
        <div class="col-12 col-md-3 text-center">
          <%= image_tag product.internal_product.image.attached? ? product.internal_product.image : "producto-chico-1.png", width: "120", class: "img-item-element", alt: "Nombre del producto" %>
        </div>
        <div class="col-12 col-md-9">
          <h4 class="product-name"><%= product.internal_product.full_name(@lang) %></h4>

          <ul class="list-group">

            <li class="list-group-item">
              <div class="row no-gutters">
                <div class="col-6 text-normal-resume-box">Precio: </div>
                <div class="col-6 text-right bold-total-resume text-normal-resume-box red-color">
                  <%= "#{number_to_currency(product.unit_price, unit: 'GS', format: '%n %u', precision: 0, delimiter: '.', separator: ',' ) }" %>
                </div>
              </div>
            </li>

            <li class="list-group-item">
              <div class="row no-gutters">
                <div class="col-6 text-normal-resume-box">Cantidad: </div>
                <div class="col-6 text-right text-normal-resume-box"><%= product.quantity.to_i %></div>
              </div>
            </li>

            <% if product.discount_amount > 0 %>
              <li class="list-group-item">
                <div class="row no-gutters">
                  <div class="col-6 text-normal-resume-box">Descuento:</div>
                  <div class="col-6 text-right text-normal-resume-box"><%= product.discount_amount.to_i %></div>
                </div>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
    <% end %>
  </div>

  <hr>

  <div class="col-12 no-gutters m-0 p-0">
    <div class="row no-gutters resumen-precio">
      <div class="col-6 col-md-9 text-right">Sub-total</div>
      <div class="col-6 col-md-3 text-right">
        <%= number_to_currency(@order.gross_total, unit: 'GS', format: '%n %u', precision: 0, delimiter: '.', separator: ',' ) %>
      </div>
    </div>

    <div class="row no-gutters resumen-precio">
      <div class="col-6 col-md-9 text-right"><%= @order.coupon_discount <= 0 ? "Descuento" : "Descuento (#{@order.coupon_discount}%)"%></div>
      <div class="col-6 col-md-3 text-right">
        <%= "-#{number_to_currency(@discount, unit: 'GS', format: '%n %u', precision: 0, delimiter: '.', separator: ',' )}" %>
      </div>
    </div>

    <div class="row no-gutters resumen-precio total">
      <div class="col-6 col-md-9 big-letter text-right red-color">Total a pagar</div>
      <div class="col-6 col-md-3 text-right big-letter red-color" id="totalPrice">
        <%= number_to_currency(@order.net_total, unit: 'GS', format: '%n %u', precision: 0, delimiter: '.', separator: ',' ) %>
      </div>
    </div>
  </div>
  <hr>
  <div class="form-group row">
    <div class="col-12">
      <%= link_to "Confirmar compra", order_confirm_path(id: @order.id), method: :post,  class: "bg-red btn-submit-login brd0 text-white mt-5" %>
    </div>
  </div>
</div>
