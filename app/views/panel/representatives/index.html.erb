<% @internal_title = "Representantes" %>
<% @page_title = "Representantes" %>
<% @action_button_path = new_panel_representative_path %>

<p class="mb-1">Filtrar contenido</p>

<%= form_with url: panel_representatives_path, method: 'get', local: true do %>
  <input type="search" name="q" value="<%= @search_text.present? ? @search_text : "" %>"
  class="search-items form-control" autofocus="true" data-table="table-data"
  placeholder="Escribe aqui para buscar...">
<% end %>

<table class="table-data table table-responsive-sm table-striped table-sm">
  <thead>
    <tr>
      <th>Nombre</th>
      <th>Dirección</th>
      <th>Teléfono</th>
      <th>Email</th>
      <th>Sitio Web</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @representatives.each do |representative| %>
    <tr>
      <td><%= representative.name %></td>
      <td><%= representative.address %></td>
      <td><%= representative.phone %></td>
      <td><%= representative.email %></td>
      <td><%= representative.website %></td>
      <td>
        <%= link_to  panel_representative_path(representative) do %>
        <i class="c-icon cil-magnifying-glass text-dark" data-placement="top" data-toggle="tooltip" title="Ver"></i>
        <% end %>
      </td>
      <td><%= link_to edit_panel_representative_path(representative) do %>
        <i class="c-icon cil-pencil text-dark" data-toggle="tooltip" title="Editar"></i>
        <% end %>
      </td>
      <td>
        <%= link_to panel_representative_path(representative), method: :delete, data: { confirm: 'Deseas eliminar este representante?' } do %>
        <i class="c-icon cil-trash text-dark" data-toggle="tooltip" title="Eliminar"></i>
        <% end %>
      </td>
    </tr>
    <% end %>
  </tbody>
</table>

<%= pagy_bootstrap_nav(@pagy).html_safe %>
