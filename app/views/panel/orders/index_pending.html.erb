<% @internal_title = "Pedidos Pendientes de Envio" %>
<% @page_title = "Pedidos pendientes de envio" %>

<p class="mb-1">Filtrar contenido</p>

<%= form_with url: panel_pending_orders_path, method: 'get', local: true do %>
  <input type="search" name="q" value="<%= @search_text.present? ? @search_text : "" %>"
  class="search-items form-control" autofocus="true" data-table="table-data"
  placeholder="Escribe aqui para buscar...">
<% end %>

<table class="table-data table table-responsive-sm table-striped table-sm">
    <thead>
        <tr>
            <th>ID</th>
            <th>Cliente</th>
            <th>Correo</th>
            <th>Razón Social</th>
            <th>Tipo</th>
            <th>Documento</th>
            <th>Total</th>
            <th>Fecha</th>
            <th>Pagado</th>
            <th>Respuesta Servicio</th>

            <th></th>
        </tr>
    </thead>

    <tbody>
        <% @orders.each do |order| %>
        <tr>
            <td><%= order.id %></td>
            <% if order.user.present? %>
              <td><%= order.user.firstname%> <%= order.user.lastname%></td>
            <% else %>
              <td>El usuario de este pedido ya no existe.</td>
            <% end %>
            <td><%= order.user.email%></td>
            <td><%= order.tax_name%></td>
            <td><%= order.tax_number_type%></td>
            <td><%= order.tax_number%></td>
            <td>
                <%= number_to_currency(order.net_total, unit: 'GS', format: '%n %u', precision: 0, delimiter: '.', separator: ',' )%>
            </td>
            <td><%= order.created_at.strftime('%F')%></td>
            <td><%if order.paid %>
                <span class="badge badge-pill badge-success">SI</span>
                <%else%>
                <span class="badge badge-pill badge-secondary">NO</span>
                <%end%>
            </td>

            <td><%= order.erp_message%></td>

            <td>
                <%= link_to  panel_order_path(order.id) do %>
                <i class="c-icon cil-magnifying-glass text-dark" data-placement="top" data-toggle="tooltip"
                    title="Ver"></i>
                <% end %>
            </td>

        </tr>
        <% end %>
    </tbody>
</table>

<%= pagy_bootstrap_nav(@pagy).html_safe %>
