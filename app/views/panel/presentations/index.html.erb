<% @internal_title = "Presentaciones" %>
<% @page_title = "Presentaciones" %>
<% @action_button_path = new_panel_presentation_path %>

<p class="mb-1">Filtrar contenido</p>

<%= form_with url: panel_presentations_path, method: 'get', local: true do %>
  <input type="search" name="q" value="<%= @search_text.present? ? @search_text : "" %>"
  class="search-items form-control" autofocus="true" data-table="table-data"
  placeholder="Escribe aqui para buscar...">
<% end %>

<table class="table-data table table-responsive-sm table-striped table-sm">
  <thead>
    <tr>
      <th>Nombre</th>
      <th>Estado</th>
      <th>Icono</th>
      <th>Peso/Cant</th>
      <th colspan="3"></th>
    </tr>
  </thead>

  <tbody>
    <% @presentations.each do |presentation| %>
    <tr>
      <td><%= presentation.name %></td>
      <td>
        <%if presentation.active %>
        <span class="badge badge-pill badge-success">Activo</span>
        <%else%>
        <span class="badge badge-pill badge-secondary">Inactivo</span>
        <%end%>
      </td>
      <td>
        <%if presentation.icon.attached? %>
        <%= image_tag presentation.icon.variant(resize: "50x50!") %>
        <%end%>
      </td>
      <td><%= presentation.size %></td>
      <td>
        <%= link_to  panel_presentation_path(presentation) do %>
        <i class="c-icon cil-magnifying-glass text-dark" data-placement="top" data-toggle="tooltip" title="Ver"></i>
        <% end %>
      </td>
      <td><%= link_to edit_panel_presentation_path(presentation) do %>
        <i class="c-icon cil-pencil text-dark" data-toggle="tooltip" title="Editar"></i>
        <% end %>
      </td>
      <td>
        <%= link_to panel_presentation_path(presentation), method: :delete, data: { confirm: 'Deseas eliminar esta presentación?' } do %>
        <i class="c-icon cil-trash text-dark" data-toggle="tooltip" title="Eliminar"></i>
        <% end %>
      </td>
      </td>
    </tr>
    <% end %>
  </tbody>
</table>

<%= pagy_bootstrap_nav(@pagy).html_safe %>
