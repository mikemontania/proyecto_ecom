<%= form_with(model: customer, local: true, :url=> (customer.new_record? ? panel_customers_path :
  panel_customer_path(customer)), class: "form-horizontal") do |form| %>
  <% if customer.errors.any? %>
    <div id="error_explanation">
      <h2>
        <%= pluralize(customer.errors.count, "error" ) %> prohibited this customer from being saved:
      </h2>

      <ul>
        <% customer.errors.full_messages.each do |message| %>
          <li>
            <%= message %>
          </li>
          <% end %>
      </ul>
    </div>
    <% end %>
      <div class="col-12">
        <div class="tab-content">
          <div class="form-group row">
            <%= form.label "Email" , class: "col-2 col-form-label" %>
              <div class="col-10">
                <%= form.text_field :email, class:"form-control" %>
              </div>
          </div>

          <div class="form-group row">
            <%= form.label "Nombre" , class: "col-2 col-form-label" %>
              <div class="col-10">
                <%= form.text_field :firstname, class:"form-control" %>
              </div>
          </div>

          <div class="form-group row">
            <%= form.label "Apellido" , class: "col-2 col-form-label" %>
              <div class="col-10">
                <%= form.text_field :lastname, class:"form-control" %>
              </div>
          </div>

          <div class="form-group row">
            <%= form.label "Tipo Documento" , class: "col-2 col-form-label" %>
              <div class="col-10">
                <%= form.select(:id_type, User::DOCUMENT_TYPES.collect {|c| [c[:name], c[:value]]}, {}, {:class=>
                  'custom-select'}) %>
              </div>
          </div>

          <div class="form-group row">
            <%= form.label "Nro Documento" , class: "col-2 col-form-label" %>
              <div class="col-10">
                <%= form.text_field :id_number, class:"form-control" %>
              </div>
          </div>


          <div class="form-group row">
            <%= form.label "Teléfono" , class: "col-2 col-form-label" %>
              <div class="col-10">
                <%= form.text_field :phone, class:"form-control" %>
              </div>
          </div>

          <div class="form-group row">
            <%= form.label "Dirección" , class: "col-2 col-form-label" %>
              <div class="col-10">
                <%= form.text_area :address, class:"form-control"%>
              </div>
          </div>

          <div class="form-group row">
            <%= form.label "Latitud" , class: "col-2 col-form-label" %>
              <div class="col-10">
                <%= form.text_field :latitude, class:"form-control" %>
              </div>
          </div>
          <div class="form-group row">
            <%= form.label "Longitud" , class: "col-2 col-form-label" %>
              <div class="col-10">
                <%= form.text_field :longitude, class:"form-control" %>
              </div>
          </div>

          <div class="form-group row">
            <div class="col-12">
              <%= form.submit (customer.new_record? ? "Crear" : "Actualizar" ), class: "btn btn-success m-5" %>
                <%= link_to 'Cancelar' , panel_customers_path, class: "btn btn-secondary m-5" %>
            </div>
          </div>

        </div>
      </div>
      <% end %>