<% @internal_title="Clientes" %>
  <% @page_title="Clientes" %>

    <p class="mb-1">Filtrar contenido</p>

    <%= form_with url: panel_customers_path, method: 'get', local: true do %>
      <input type="search" name="q" value="<%= @search_text.present? ? @search_text : "" %>"
      class="search-items form-control" autofocus="true" data-table="table-data"
      placeholder="Escribe aqui para buscar...">
    <% end %>

    <table class="table-data table table-responsive-sm table-striped table-sm">
      <thead>
        <tr>
          <th>ID</th>
          <th>Email</th>
          <th>Nombre</th>
          <th>Apellido</th>
          <th>Telefono</th>
          <th>Dirección</th>
          <th colspan="2"></th>
        </tr>
      </thead>

      <tbody>
        <% @customers.each do |customer| %>
          <tr>
            <td>
              <%= customer.id %>
            </td>
            <td>
              <%= customer.email %>
            </td>
            <td>
              <%= customer.firstname %>
            </td>
            <td>
              <%= customer.lastname %>
            </td>
            <td>
              <%= customer.phone %>
            </td>
            <td>
              <%= customer.address %>
            </td>
            <td>
              <%= link_to edit_panel_customer_path(customer.id) do %>
                <i class="c-icon cil-pencil text-dark" data-toggle="tooltip" title="Editar"></i>
                <% end %>
            </td>
            <td>
              <%= link_to panel_customer_path(customer.id), method: :delete, data: {
                confirm: 'Deseas eliminar este cliente?' } do %>
                <i class="c-icon cil-trash text-dark" data-toggle="tooltip" title="Eliminar"></i>
                <% end %>
            </td>
          </tr>
          <% end %>
      </tbody>
    </table>

<%= pagy_bootstrap_nav(@pagy).html_safe %>
