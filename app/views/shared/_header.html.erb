</header><!-- /header -->

<div class="search-form-wrap" id="formSearchWrap">
  <%= form_with url: search_path, method: 'get', local: true do %>
  <span class="back-button-search float-left" id="backButtonSearch">
    <i class="fas fa-arrow-left"></i>
  </span>
  <%= text_field_tag 'q', nil, class:" input-text-search" %>
  <%= button_tag type: 'submit', class:"btn btn-search-top" do  %>
  <div class="inline-block-vat icons-right-menu-mobile" id="buttonSearch">
    <i class="fas fa-search"></i>
  </div>
  <% end %>



  <% end %>

</div>
