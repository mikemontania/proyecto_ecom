<% @internal_title="Configuración" %>
<% @page_title="Configuración" %>

<%= form_with(model: @delivery_schedule, local: true, :url=> panel_delivery_schedule_update_path, class: "form-horizontal") do
  |form| %>
  <% if @delivery_schedule.errors.any? %>
    <div id="error_explanation">
      <h2>
        <%= pluralize(@delivery_schedule.errors.count, "error" ) %> prohibited this object from being saved:
      </h2>

      <ul>
        <% @settings.errors.full_messages.each do |message| %>
          <li>
            <%= message %>
          </li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group row">
    <%= form.label "Mensaje:", class: "col-3 col-form-label" %>
    <div class="col-4">
      <%= form.text_field :title, class:"form-control" %>
    </div>
  </div>

  <div class="form-group row">
    <%= form.label "Horario inicio Lunes a Viernes", class: "col-3 col-form-label" %>
    <div class="col-4">
      <%= form.time_field :week_start_hour, value: get_time(@delivery_schedule.week_start_hour), class:"form-control" %>
    </div>
  </div>

  <div class="form-group row">
    <%= form.label "Horario fin Lunes a Viernes", class: "col-3 col-form-label" %>
    <div class="col-4">
      <%= form.time_field :week_end_hour, value: get_time(@delivery_schedule.week_end_hour), class:"form-control" %>
    </div>
  </div>

  <div class="form-group row">
    <%= form.label "Horario inicio Sábado", class: "col-3 col-form-label" %>
    <div class="col-4">
      <%= form.time_field :weekend_start_hour, value: get_time(@delivery_schedule.weekend_start_hour), class:"form-control" %>
    </div>
  </div>

  <div class="form-group row">
    <%= form.label "Horario fin Sábado", class: "col-3 col-form-label" %>
    <div class="col-4">
      <%= form.time_field :weekend_end_hour, value: get_time(@delivery_schedule.weekend_end_hour), class:"form-control" %>
    </div>
  </div>

  <div class="form-group row">
    <%= form.label "Carga de Feriados", class: "col-3 col-form-label" %>
    <div class="col-4">
      <%= form.text_field :holydays, class:"form-control", id: "multi-dates" %>
    </div>
  </div>

  <div class="form-group row">
    <div class="col-12">
      <%= form.submit "Actualizar" , class: "btn btn-success m-5" %>
    </div>
  </div>
<% end %>
