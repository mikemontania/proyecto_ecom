<% @internal_title = "Descuentos por Importe" %>
<% @page_title = "Descuentos por Importe" %>
<% @action_button_path = new_panel_amount_discount_path %>

<p class="mb-1">Filtrar contenido</p>

<%= form_with url: panel_amount_discounts_path, method: 'get', local: true do %>
  <input type="search" name="q" value="<%= @search_text.present? ? @search_text : "" %>"
  class="search-items form-control" autofocus="true" data-table="table-data"
  placeholder="Escribe aqui para buscar...">
<% end %>

<table class="table-data table table-responsive-sm table-striped table-sm">
  <thead>
    <tr>
      <th>Importe minimo</th>
      <th>Importe maximo</th>
      <th>Descuento %</th>
      <th>Fecha inicio</th>
      <th>Fecha fin</th>
      <th colspan="2"></th>
    </tr>
  </thead>

  <tbody>
    <% @amount_discounts.each do |amount_discount| %>
    <tr>
      <td>
        <%= number_to_currency(amount_discount.min_amount, unit: 'GS', format: '%n %u', precision: 0, delimiter: '.', separator: ',' ) %>
      </td>
      <td>
        <%= number_to_currency(amount_discount.max_amount, unit: 'GS', format: '%n %u', precision: 0, delimiter: '.', separator: ',' ) %>
      </td>
      <td><%= amount_discount.discount_rate %></td>
      <td><%= amount_discount.begin_date %></td>
      <td><%= amount_discount.end_date %></td>
      <td><%= link_to edit_panel_amount_discount_path(amount_discount) do %>
        <i class="c-icon cil-pencil text-dark" data-toggle="tooltip" title="Editar"></i>
        <% end %>
      </td>
      <td>
        <%= link_to panel_amount_discount_path(amount_discount), method: :delete, data: { confirm: 'Deseas eliminar este descuento?' } do %>
        <i class="c-icon cil-trash text-dark" data-toggle="tooltip" title="Eliminar"></i>
        <% end %>
      </td>
    </tr>
    <% end %>
  </tbody>
</table>

<%= pagy_bootstrap_nav(@pagy).html_safe %>
