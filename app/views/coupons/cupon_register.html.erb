  <div class="form-group align-center" style="margin: 10rem 0;">
    <span class="text-grey span-text-form-input" style="display:block; margin-bottom: 3rem;">Registrate con: </span>

    <%= link_to omniauth_authorize_path('user', 'facebook', promo: @promo), style: 'display: inline-block; margin-left: 20px;', class: 'buttons-sm-register' do %>
      <div style="display: flex;
      background-color: #4267b2;
      color: #fff;
      font-weight: 900;
      font-size: 15px;
      height: 40px;
      width: 130px;
      border-radius: 5px;
      justify-content: center;
      align-items: center;">
        <i class="fab fa-facebook-f mr-3"></i>
        <p class="text-white m-0">Facebook</p>
      </div>
    <% end %>

    <%= link_to omniauth_authorize_path('user', 'google_oauth2', promo: @promo), style: 'display: inline-block; margin-left: 20px;', class: 'buttons-sm-register' do %>
      <div style="display: flex;
      background-color: #b24242;
      color: #fff;
      font-weight: 900;
      font-size: 15px;
      height: 40px;
      width: 130px;
      border-radius: 5px;
      justify-content: center;
      align-items: center;">
        <i class="fab fa-google mr-3"></i>
        <p class="text-white m-0">Google</p>
      </div>
    <% end %>

    <%= link_to new_registration_path(@resource_name, promo: @promo), style: 'display: inline-block; margin-left: 20px;', class: 'buttons-sm-register' do %>
      <div style="display: flex;
      background-color: #cf0003;
      color: #fff;
      font-weight: 900;
      font-size: 15px;
      height: 40px;
      width: 130px;
      border-radius: 5px;
      justify-content: center;
      align-items: center;">
        <i class="far fa-envelope mr-3"></i>
        <p class="text-white m-0">Cavallaro</p>
      </div>
    <% end %>
  </div>

