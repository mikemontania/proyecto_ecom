<%= form_with(model: variety, local: true, :url => (variety.new_record? ? panel_varieties_path : panel_variety_path(variety)), class: "form-horizontal") do |form| %>
<% if variety.errors.any? %>
<div id="error_explanation">
  <h2><%= pluralize(variety.errors.count, "error") %> prohibited this variety from being saved:</h2>

  <ul>
    <% variety.errors.full_messages.each do |message| %>
    <li><%= message %></li>
    <% end %>
  </ul>
</div>
<% end %>

<div class="col-12">
  <ul class="nav nav-tabs" role="tablist">
    <li class="nav-item"><a class="nav-link active" data-toggle="tab" href="#es" role="tab" aria-controls="es">
        <i class="c-icon cif-py"></i></a></li>
    <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#en" role="tab" aria-controls="en">
        <i class="c-icon cif-us"></i></a></li>
    <li class="nav-item"><a class="nav-link" data-toggle="tab" href="#br" role="tab" aria-controls="br">
        <i class="c-icon cif-br"></i></a></li>
  </ul>
  <br />
  <div class="tab-content">
    <div class="tab-pane active" id="es" role="tabpanel">
      <div class="form-group row">
        <%= form.label "Nombre", class: "col-2 col-form-label" %>
        <div class="col-10">
          <%= form.text_field :name_es, class:"form-control" %>
        </div>
      </div>
    </div>
    <div class="tab-pane" id="en" role="tabpanel">
      <div class="form-group row">
        <%= form.label "Nombre", class: "col-2 col-form-label" %>
        <div class="col-10">
          <%= form.text_field :name_en, class:"form-control" %>
        </div>
      </div>
    </div>
    <div class="tab-pane" id="br" role="tabpanel">
      <div class="form-group row">
        <%= form.label "Nombre", class: "col-2 col-form-label" %>
        <div class="col-10">
          <%= form.text_field :name_br, class:"form-control" %>
        </div>
      </div>
    </div>

    <hr />

    <div class="form-group row">
      <%= form.label "Color", class: "col-2 col-form-label" %>
      <div class="col-10">

        <%= form.color_field :color %>
        <% if variety.new_record? %>
        <%= form.label "#000", class: "ml-5" %>
        <% else %>
        <%= form.label "#{form.object.color}", class: "ml-5" %>
        <% end %>

      </div>
    </div>

    <div class="form-group row">
      <%= form.label "Activo", class: "col-2 col-form-label" %>
      <div class="col-10">
        <label class="c-switch c-switch-sm c-switch-pill c-switch-success">
          <%= form.check_box :active, class:"c-switch-input" %>
          <span class="c-switch-slider"></span>
        </label>
      </div>
    </div>

    <div class="form-group row">
      <div class="col-12">
        <%= form.submit (variety.new_record? ? "Crear" : "Actualizar" ), class: "btn btn-success m-5" %>
        <%= link_to 'Cancelar', panel_varieties_path, data: { turbolinks: false }, class: "btn btn-secondary m-5" %>
      </div>
    </div>

  </div>
</div>
<% end %>
